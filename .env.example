# Copy to `.env.local` for local development. Production: see deploy/.env.production.example.
# NEXT_PUBLIC_* values are inlined at build time and visible in the browser: never put secrets here.

# Backend API, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Branding
NEXT_PUBLIC_APP_NAME=KampusPing
NEXT_PUBLIC_APP_DESCRIPTION=Sistem penagihan uang kuliah via WhatsApp untuk Bagian Keuangan.
# Optional logo image served from /public (e.g. /logo.svg). Empty shows a monogram.
NEXT_PUBLIC_APP_LOGO=
NEXT_PUBLIC_PRIMARY_COLOR=#0F766E

# light | dark | system
NEXT_PUBLIC_DEFAULT_THEME_MODE=system

# Locale for dates and numbers (en or id are bundled).
NEXT_PUBLIC_LOCALE=id

# Nginx: web app (production)
# Browser -> HTTPS load balancer / TLS terminator -> Nginx :80 -> PM2 next start 127.0.0.1:8094
# Replace server_name with your web domain before installing.

upstream webapp_frontend_prod {
    server 127.0.0.1:8094;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://webapp_frontend_prod;
    }
}

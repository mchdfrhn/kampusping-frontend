# Production environment. Copy to `.env` on the server BEFORE building: NEXT_PUBLIC_* values
# are inlined into the browser bundle at build time and are visible to every visitor.
# Never put secrets here, and never commit the real file.

# Public URL of the backend API, including /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

NEXT_PUBLIC_APP_NAME=KampusPing
NEXT_PUBLIC_APP_DESCRIPTION=A clean, modern starting point for business web applications.
NEXT_PUBLIC_APP_LOGO=
NEXT_PUBLIC_PRIMARY_COLOR=#0F766E
NEXT_PUBLIC_DEFAULT_THEME_MODE=system
NEXT_PUBLIC_LOCALE=en
